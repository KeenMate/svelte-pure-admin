{
  "name": "@keenmate/svelte-pure-admin",
  "version": "1.1.5",
  "description": "Svelte 5 component library for Pure Admin CSS framework - 80+ ready-to-use components for building admin dashboards",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "dev": "svelte-package --watch",
    "build": "svelte-package",
    "package": "npm run build && publint",
    "prepublishOnly": "npm run package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "clean": "rm -rf dist .svelte-kit"
  },
  "peerDependencies": {
    "@keenmate/pure-admin-core": "^1.1.3",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@keenmate/pure-admin-core": "file:../../../pure-admin/packages/core",
    "@keenmate/pure-admin-theme-audi": "file:../../../pure-admin/packages/theme-audi",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "publint": "^0.2.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.1"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "sveltekit",
    "pure-admin",
    "admin",
    "dashboard",
    "components",
    "ui",
    "component-library",
    "admin-panel"
  ],
  "author": "KeenMate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keenmate/svelte-pure-admin.git",
    "directory": "packages/svelte-pure-admin"
  },
  "homepage": "https://github.com/keenmate/svelte-pure-admin#readme",
  "bugs": {
    "url": "https://github.com/keenmate/svelte-pure-admin/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
